{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "packages/harness-acp": {
      "entry": ["fixtures/agent.mjs"],
      "project": ["src/**/*.ts", "fixtures/*.mjs"]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"]
    },
    "packages/core": {
      "entry": ["src/browser-mcp-launcher.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/schema": {
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    },
    "packages/canary": {
      "entry": ["src/**/*.story.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/claudexor": {
      "entry": ["bin/*.js", "pi/index.js"],
      "project": ["bin/*.js", "pi/*.js"]
    },
    "packages/daemon": {
      "entry": ["src/run-deadline-warden-main.ts", "src/test-support/run-deadline-daemon-child.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    },
    "benchmarks/runner": {
      "project": ["src/**/*.ts"]
    },
    ".": {
      "entry": ["scripts/*.mjs", "scripts/benchmarks/daemon-load-fixture.mjs"],
      "project": ["scripts/**/*.mjs"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "rules": {
    "exports": "error",
    "types": "error",
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "optionalPeerDependencies": "off",
    "unlisted": "warn",
    "binaries": "off",
    "unresolved": "off",
    "duplicates": "warn",
    "enumMembers": "error",
    "nsExports": "off",
    "nsTypes": "off"
  },
  "ignore": ["packages/daemon/src/store/test-support/fixtures/legacy/**"]
}
