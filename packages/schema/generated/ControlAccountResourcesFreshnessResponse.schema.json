                    "$ref": "#/definitions/ControlAccountResourcesFreshnessResponse/properties/resources/items/properties/balances/properties/value/anyOf/0/items/properties/period/properties/starts_at"
                  },
                  "last_error": {
                    "type": [
                      "string",
                      "null"
