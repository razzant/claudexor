                              "type": [
                                "boolean",
                                "null"
                              ]
                            },
                            "unlimited": {
                              "type": [
                                "boolean",
                                "null"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "amount",
                            "unit",
                            "currency",
                            "decimal_places",
                            "has_balance",
                            "unlimited"
                          ],
                          "additionalProperties": false
                        }
                      },
                      {
                        "type": "null"
