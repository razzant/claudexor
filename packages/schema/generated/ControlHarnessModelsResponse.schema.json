{
  "$ref": "#/definitions/ControlHarnessModelsResponse",
  "definitions": {
    "ControlHarnessModelsResponse": {
      "type": "object",
      "properties": {
        "harnessId": {
          "type": "string",
          "description": "Harness the models belong to."
        },
        "sourceProgram": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "processing": {
                "type": "object",
                "properties": {
                  "modes": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "standard",
                            "fast",
                            "economy"
                          ],
                          "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "nativeModes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "$ref": "#/definitions/ControlHarnessModelsResponse/properties/models/items/properties/processing/properties/modes/anyOf/0/items"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S",
                          "description": "User-supplied string that must contain visible content, not just whitespace."
                        }
                      },
                      "required": [
                        "mode",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "defaultNativeMode": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/ControlHarnessModelsResponse/properties/models/items/properties/processing/properties/nativeModes/items/properties/id"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "User-supplied string that must contain visible content, not just whitespace."
                  },
                  "eligible": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "source": {
                    "$ref": "#/definitions/ControlHarnessModelsResponse/properties/models/items/properties/processing/properties/nativeModes/items/properties/id"
                  },
                  "observedAt": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "description": "ISO-8601 timestamp string."
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "ISO-8601 timestamp string."
                  }
                },
                "required": [
                  "modes",
                  "nativeModes",
                  "defaultNativeMode",
                  "eligible",
                  "source",
                  "observedAt"
                ],
                "additionalProperties": false,
                "description": "Exact model/account service evidence. Null modes or eligibility means unknown, not unsupported; native IDs remain adapter-owned. Transport support is declared separately."
              },
              "id": {
                "type": "string",
                "description": "Model id as the vendor enumerates it."
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null,
                "description": "Human-readable model label; null when the enumeration source has none."
              },
              "context_window": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Context window in tokens; null when the enumeration source does not report it."
              },
              "input_modalities": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/ControlHarnessModelsResponse/properties/models/items/properties/processing/properties/nativeModes/items/properties/id"
                },
                "minItems": 1,
                "description": "Input modalities the live catalog declares for this model, verbatim (e.g. text, image, file); absent = unknown, never an empty or 'none' claim. Declared metadata that refuses no request."
              },
              "max_output_tokens": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Largest completion the live catalog declares for this model (OpenRouter top_provider.max_completion_tokens); absent = unknown. Input and output share the context window, so the effective maximum can be lower."
              },
              "routes": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "local_session",
                        "api_key"
                      ]
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Credential routes the model is scoped to; null = every route."
              },
              "origin": {
                "type": "string",
                "enum": [
                  "live",
                  "hint"
                ],
                "description": "Where this row came from: live = the vendor's own enumeration reported it; hint = a frozen known-model id the producer appends when its live answer lacks it or could not be read. Absent = live."
              },
              "resolved_model": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "For an alias row, the exact model id the vendor reported it resolves to at enumeration time; null or absent when the source reports none. The row id is what is sent; this is never substituted for it."
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "description": "One enumerable model offered by a harness, limited to fields a real enumeration source can honestly populate."
          },
          "default": [],
          "description": "Enumerable models; empty when the harness has no model truth source."
        },
        "source": {
          "type": "string",
          "enum": [
            "api",
            "manifest",
            "none"
          ],
          "description": "Provenance of the list: api (a live vendor enumeration), manifest (the manifest's known-good hint set), or none (no model truth source; explicit models are refused)."
        },
        "verifiedAgainst": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Vendor CLI version the manifest hints were last verified against; null for api/none sources."
        },
        "problem": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "fieldErrors": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {}
            },
            "requiredActions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": []
            },
            "context": {
              "type": "object",
              "additionalProperties": {},
              "default": {},
              "description": "Typed route-specific recovery context; never a duplicate error message."
            }
          },
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "additionalProperties": false,
          "description": "Present only when the live catalog read failed (code model_catalog_unavailable; context.cause names no_credential, auth_rejected, http_status, network, timeout, malformed or incomplete): models is then empty and is NOT an empty catalog."
        },
        "routingVariants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "suffix": {
                "type": "string",
                "pattern": "^:[a-z][a-z0-9_-]*$",
                "description": "The suffix, colon included (e.g. ':nitro')."
              },
              "billing": {
                "type": "string",
                "enum": [
                  "base",
                  "service_tier"
                ],
                "description": "base = billed like the listed row; service_tier = the provider may serve it on another service tier billed at that tier's rate."
              }
            },
            "required": [
              "suffix",
              "billing"
            ],
            "additionalProperties": false,
            "description": "One declared request-time routing suffix and its billing effect."
          },
          "minItems": 1,
          "description": "The harness's declared request-time routing suffixes, so a surface finds the listed row of a variant id (#146); omitted when none are declared."
        }
      },
      "required": [
        "harnessId",
        "source"
      ],
      "additionalProperties": false,
      "description": "Models enumerable for one harness, with honest provenance."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
