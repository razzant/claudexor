{
  "$ref": "#/definitions/RawContextPacket",
  "definitions": {
    "RawContextPacket": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "packet_hash": {
          "type": "string",
          "minLength": 1,
          "description": "Content hash in algo:hex form, e.g. \"sha256:abcd...\"."
        },
        "budget": {
          "type": "object",
          "properties": {
            "estimator": {
              "type": "string",
              "const": "chars_div_4"
            },
            "basis": {
              "type": "string",
              "enum": [
                "model_context_window",
                "assumed_ceiling"
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Model whose catalog row was consulted; null when the producer reported none."
            },
            "context_window": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_allowance_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "framing_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Estimated tokens of the request outside this packet; null when unmeasured."
            },
            "selection_limit_tokens": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "Limit the optional selection honoured: the packet's share of the window, or the assumed ceiling on file contents."
            },
            "estimated_packet_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "omitted_for_budget": {
              "type": "integer",
              "minimum": 0,
              "description": "Optional files left out to honour selection_limit_tokens (listed in omissions)."
            },
            "mandatory_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Project mandatory files, each delivered complete in readable_files."
            }
          },
          "required": [
            "estimator",
            "basis",
            "model",
            "context_window",
            "output_allowance_tokens",
            "framing_tokens",
            "selection_limit_tokens",
            "estimated_packet_tokens",
            "omitted_for_budget",
            "mandatory_paths"
          ],
          "additionalProperties": false,
          "description": "Sizing evidence for a raw context packet; disclosed, never a tokenizer count."
        },
        "base_commit_sha": {
          "type": "string",
          "minLength": 1,
          "description": "The run's delivery base commit; every round of a run names the same one."
        },
        "base_tree_sha": {
          "type": "string",
          "minLength": 1,
          "description": "The exact tree this request describes and its patch applies to: the delivery base's tree on a first round, afterwards the candidate an earlier round left."
        },
        "readable_files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Exact repo-relative readable/editable path."
              },
              "mode": {
                "type": "string",
                "description": "Git object mode in the packet's exact tree."
              },
              "blob_oid": {
                "type": "string",
                "minLength": 1,
                "description": "Git blob oid in the packet's exact tree."
              },
              "content_hash": {
                "$ref": "#/definitions/RawContextPacket/properties/packet_hash"
              },
              "content": {
                "type": "string",
                "description": "Complete text content; never truncated."
              }
            },
            "required": [
              "path",
              "mode",
              "blob_oid",
              "content_hash",
              "content"
            ],
            "additionalProperties": false
          }
        },
        "editable_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "creatable_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Exact repo-relative roots where a patch may add a new path; '.' means the project root."
        },
        "file_manifest": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Repo-relative path."
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "full",
                  "included",
                  "manifest_only",
                  "excluded",
                  "sensitive",
                  "binary",
                  "vendored",
                  "oversized",
                  "read_error",
                  "omitted"
                ],
                "description": "How a tracked path was accounted for in the Scope Atlas (full/included content, manifest_only, or excluded/sensitive/binary/vendored/oversized/read_error/omitted); no path is ever silently dropped."
              },
              "hash": {
                "$ref": "#/definitions/RawContextPacket/properties/packet_hash",
                "description": "Content hash of the path, when read."
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "Size of the path in bytes, when known."
              },
              "reason": {
                "type": "string",
                "description": "Why the path got this disposition."
              }
            },
            "required": [
              "path",
              "disposition"
            ],
            "additionalProperties": false,
            "description": "Accounting entry for one tracked path in the Scope Atlas."
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Repo-relative path that was omitted."
              },
              "reason": {
                "type": "string",
                "description": "Why the path was omitted."
              },
              "replacement": {
                "type": "string",
                "enum": [
                  "summary",
                  "map",
                  "index",
                  "none"
                ],
                "default": "none",
                "description": "What stands in for the omitted content: a summary, a map, an index, or nothing."
              },
              "hash": {
                "$ref": "#/definitions/RawContextPacket/properties/packet_hash",
                "description": "Content hash of the omitted file, when known."
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false,
            "description": "Explicit record of a file omitted from the context; nothing is silently cut."
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "packet_hash",
        "base_commit_sha",
        "base_tree_sha",
        "readable_files",
        "editable_paths",
        "file_manifest",
        "omissions",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
