{
  "$ref": "#/definitions/ModelCallResult",
  "definitions": {
    "ModelCallResult": {
      "type": "object",
      "properties": {
        "routing": {
          "type": "object",
          "properties": {
            "selectionReason": {
              "type": "string",
              "enum": [
                "listed",
                "unlisted_fallback",
                "marked_fallback",
                "preferred",
                "pinned",
                "probe"
              ]
            },
            "retryOfOperationId": {
              "type": "string",
              "minLength": 1,
              "description": "Non-empty identifier string."
            },
            "differentialOutcome": {
              "type": "string",
              "enum": [
                "provisional",
                "confirmed",
                "equivalent_refusal",
                "inconclusive"
              ]
            },
            "poolEvents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "payload": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type",
                  "payload"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "selectionReason",
            "poolEvents"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "type": "string",
          "enum": [
            "completed",
            "incomplete",
            "failed",
            "unknown"
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "system",
                    "developer",
                    "user",
                    "assistant",
                    "tool"
                  ]
                },
                "content": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {}
                          }
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "type": "string"
                },
                "tool_call_id": {
                  "$ref": "#/definitions/ModelCallResult/properties/routing/properties/retryOfOperationId",
                  "description": "Non-empty identifier string."
                },
                "tool_calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "$ref": "#/definitions/ModelCallResult/properties/routing/properties/retryOfOperationId"
                      },
                      "type": {
                        "type": "string",
                        "const": "function"
                      },
                      "function": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S",
                            "description": "User-supplied string that must contain visible content, not just whitespace."
                          },
                          "arguments": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "arguments"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "id",
                      "type",
                      "function"
                    ],
                    "additionalProperties": false
                  }
                },
                "nativeContinuation": {
                  "type": "object",
                  "properties": {
                    "route": {
                      "type": "object",
                      "properties": {
                        "source": {
                          "$ref": "#/definitions/ModelCallResult/properties/routing/properties/retryOfOperationId"
                        },
                        "credentialProfileId": {
                          "$ref": "#/definitions/ModelCallResult/properties/routing/properties/retryOfOperationId"
                        },
                        "accountFingerprint": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "model": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "source",
                        "credentialProfileId",
                        "accountFingerprint",
                        "model"
                      ],
                      "additionalProperties": false,
                      "description": "Selected route at dispatch; a result records the actually observed model, or null."
                    },
                    "format": {
                      "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                    },
                    "payload": {}
                  },
                  "required": [
                    "route",
                    "format"
                  ],
                  "additionalProperties": false,
                  "description": "Opaque provider-native continuation bound to its account and model; its format distinguishes assistant content from live transport state."
                }
              },
              "required": [
                "role",
                "content"
              ],
              "additionalProperties": false,
              "description": "Caller-owned conversation message. Text, content blocks, and tool arguments are not redacted or rewritten."
            },
            {
              "type": "null"
            }
          ],
          "description": "Caller-owned conversation message. Text, content blocks, and tool arguments are not redacted or rewritten."
        },
        "route": {
          "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/nativeContinuation/properties/route"
        },
        "modelMismatch": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "requested": {
                  "type": "string"
                },
                "observed": {
                  "type": "string"
                }
              },
              "required": [
                "requested",
                "observed"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Requested-vs-observed model mismatch on a completed or incomplete terminal response; null or absent when they match or either side is unknown. The outcome is unchanged."
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cached_input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cache_write_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "reasoning_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "description": "Provider-reported counters for one generation; missing counters remain null."
        },
        "cost": {
          "type": "object",
          "properties": {
            "processing": {
              "type": "object",
              "properties": {
                "nativeMode": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "User-supplied string that must contain visible content, not just whitespace."
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "included",
                    "paid_credits",
                    "cash",
                    "valuation",
                    "unknown"
                  ]
                },
                "source": {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                "debit": {
                  "type": "string",
                  "const": "unobserved",
                  "description": "The route reports no actual cash or purchased-credit debit. Included service still admits the work, but its cash stays unknown instead of zero and is outside the finite cap; absence keeps proven ordinary inclusion as zero cash."
                }
              },
              "required": [
                "nativeMode",
                "kind",
                "source"
              ],
              "additionalProperties": false,
              "description": "Mode-qualified billing evidence for an existing cost record. Authentication alone does not establish included premium service; credits, cash, and token valuation stay distinct."
            },
            "knowledge": {
              "type": "string",
              "enum": [
                "exact",
                "estimated",
                "unknown"
              ],
              "description": "Quality of incremental-cash cost evidence for an operation."
            },
            "billing": {
              "type": "string",
              "enum": [
                "proven_zero",
                "subscription_entitlement",
                "metered",
                "unknown"
              ],
              "description": "What is actually known about incremental billing; a native credential route alone never proves entitlement or zero cost."
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "provenance": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "estimatedUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cashUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "valuationUsd": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "valuationKnowledge": {
              "$ref": "#/definitions/ModelCallResult/properties/cost/properties/knowledge",
              "default": "unknown",
              "description": "Quality of incremental-cash cost evidence for an operation."
            }
          },
          "required": [
            "knowledge",
            "billing",
            "source",
            "provenance"
          ],
          "additionalProperties": false,
          "description": "Incremental cash and token valuation are independent; subscription credentials alone never invent a cash receipt."
        },
        "appliedOptions": {
          "type": "object",
          "properties": {
            "reasoningEffort": {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name",
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "serviceTier": {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name",
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "processingPreference": {
              "type": "string",
              "enum": [
                "standard",
                "fast",
                "economy"
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "parallelToolCalls": {
              "type": "boolean"
            },
            "cacheKey": {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name",
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "maxOutputTokens": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "temperature": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "description": "Generation options only, not a caller's context/output reserve; reasoningEffort is an adaptive preference, while unsupported other explicit options refuse before inference."
        },
        "effortResolution": {
          "type": "object",
          "properties": {
            "requested": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Original effort preference before adaptation; null when none was requested."
            },
            "submitted": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native option prepared for transport; null means omitted, never the explicit token none. Not proof of dispatch."
            },
            "resolution": {
              "type": "string",
              "enum": [
                "exact",
                "downward",
                "floor",
                "omitted",
                "unverifiable",
                "rejected"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "account_catalog",
                "live_probe",
                "versioned_snapshot",
                "adapter"
              ]
            },
            "parameter": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Native carrier, such as reasoning.effort, model_reasoning_effort or --effort; null when no separate knob is carried."
            },
            "observed": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Provider-reported effort only; null when unobserved, never copied from submission."
            },
            "observedSource": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Provider event/field that reported observed effort; null when unobserved."
            },
            "reason": {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name",
              "description": "Diagnostic explanation; consumers branch on resolution, never prose."
            }
          },
          "required": [
            "requested",
            "submitted",
            "resolution",
            "source",
            "parameter",
            "observed",
            "observedSource"
          ],
          "additionalProperties": false,
          "description": "Prepared and observed effort evidence; model operations retain it only when creation requests captureEffortEvidence=true. Legacy results omit it before immutable publication."
        },
        "processing": {
          "type": "object",
          "properties": {
            "requested": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/appliedOptions/properties/processingPreference"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "submitted": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/appliedOptions/properties/processingPreference"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "submittedNative": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "observed": {
              "type": "string",
              "enum": [
                "standard",
                "fast",
                "economy",
                "mixed",
                "unknown"
              ]
            },
            "observedNative": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
              }
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "source": {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
            }
          },
          "required": [
            "requested",
            "submitted",
            "submittedNative",
            "observed",
            "observedNative",
            "reason",
            "source"
          ],
          "additionalProperties": false,
          "description": "Requested intent, submitted native control, and observed execution are independent facts. A submitted flag never proves observed service; mixed or missing session observations remain explicit."
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "fieldErrors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "default": {}
                },
                "requiredActions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "context": {
                  "type": "object",
                  "additionalProperties": {},
                  "default": {},
                  "description": "Typed route-specific recovery context; never a duplicate error message."
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "failureEvidence": {
          "type": "object",
          "properties": {
            "bodyBase64": {
              "type": "string"
            },
            "receivedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "bodyComplete": {
              "type": "boolean",
              "description": "True only when the response reader observed EOF."
            },
            "stage": {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/tool_calls/items/properties/function/properties/name"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "stack": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "code": {
                    "anyOf": [
                      {
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "message",
                  "stack",
                  "code"
                ],
                "additionalProperties": false
              },
              "description": "Original exception followed by causes and AggregateError members in depth-first order; empty when none was thrown."
            },
            "causeCycle": {
              "type": "boolean"
            }
          },
          "required": [
            "bodyBase64",
            "receivedBytes",
            "bodyComplete",
            "stage",
            "errors",
            "causeCycle"
          ],
          "additionalProperties": false,
          "description": "Private failed-response evidence: every byte returned to the reader, never an unreceived suffix. Retained only inside the model result resource when requested."
        },
        "nativeContinuation": {
          "anyOf": [
            {
              "$ref": "#/definitions/ModelCallResult/properties/message/anyOf/0/properties/nativeContinuation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Live transport continuation, present only when the request opted in; preserve independently of response body success."
        }
      },
      "required": [
        "outcome",
        "message",
        "route",
        "usage",
        "cost",
        "appliedOptions",
        "problem"
      ],
      "additionalProperties": false,
      "description": "One provider outcome; completed means a terminal response, never an EOF or a partial tool argument."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
