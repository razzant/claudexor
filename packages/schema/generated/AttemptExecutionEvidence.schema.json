{
  "$ref": "#/definitions/AttemptExecutionEvidence",
  "definitions": {
    "AttemptExecutionEvidence": {
      "type": "object",
      "properties": {
        "programs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "versionSource": {
                "type": "string",
                "enum": [
                  "vendor_stream",
                  "version_probe",
                  "remembered",
                  "unknown"
                ]
              }
            },
            "required": [
              "path",
              "version",
              "versionSource"
            ],
            "additionalProperties": false
          }
        },
        "attemptId": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty identifier string."
        },
        "harnessId": {
          "$ref": "#/definitions/AttemptExecutionEvidence/properties/attemptId"
        },
        "processing": {
          "type": "object",
          "properties": {
            "requested": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "standard",
                    "fast",
                    "economy"
                  ],
                  "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "submitted": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AttemptExecutionEvidence/properties/processing/properties/requested/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Advisory service preference. Fast or Economy may use ordinary Standard service; fallback never introduces Fast. Omission preserves native defaults. Explicit native serviceTier takes precedence."
            },
            "submittedNative": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "description": "User-supplied string that must contain visible content, not just whitespace."
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "observed": {
              "type": "string",
              "enum": [
                "standard",
                "fast",
                "economy",
                "mixed",
                "unknown"
              ]
            },
            "observedNative": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/AttemptExecutionEvidence/properties/processing/properties/submittedNative/anyOf/0"
              }
            },
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AttemptExecutionEvidence/properties/processing/properties/submittedNative/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "source": {
              "$ref": "#/definitions/AttemptExecutionEvidence/properties/processing/properties/submittedNative/anyOf/0"
            }
          },
          "required": [
            "requested",
            "submitted",
            "submittedNative",
            "observed",
            "observedNative",
            "reason",
            "source"
          ],
          "additionalProperties": false,
          "description": "Requested intent, submitted native control, and observed execution are independent facts. A submitted flag never proves observed service; mixed or missing session observations remain explicit."
        },
        "processingCostBasis": {
          "type": "object",
          "properties": {
            "nativeMode": {
              "anyOf": [
                {
                  "$ref": "#/definitions/AttemptExecutionEvidence/properties/processing/properties/submittedNative/anyOf/0"
                },
                {
                  "type": "null"
                }
              ],
              "description": "User-supplied string that must contain visible content, not just whitespace."
            },
            "kind": {
              "type": "string",
              "enum": [
                "included",
                "paid_credits",
                "cash",
                "valuation",
                "unknown"
              ]
            },
            "source": {
              "$ref": "#/definitions/AttemptExecutionEvidence/properties/processing/properties/submittedNative/anyOf/0"
            },
            "debit": {
              "type": "string",
              "const": "unobserved",
              "description": "The route reports no actual cash or purchased-credit debit. Included service still admits the work, but its cash stays unknown instead of zero and is outside the finite cap; absence keeps proven ordinary inclusion as zero cash."
            }
          },
          "required": [
            "nativeMode",
            "kind",
            "source"
          ],
          "additionalProperties": false,
          "description": "Mode-qualified billing evidence for an existing cost record. Authentication alone does not establish included premium service; credits, cash, and token valuation stay distinct."
        },
        "usageCost": {
          "type": "object",
          "properties": {
            "cashUsd": {
              "type": "number",
              "minimum": 0
            },
            "valuationUsd": {
              "type": "number",
              "minimum": 0
            },
            "unknownUsd": {
              "type": "number",
              "minimum": 0
            },
            "cashKnowledge": {
              "type": "string",
              "enum": [
                "exact",
                "estimated",
                "unknown"
              ],
              "description": "Quality of incremental-cash cost evidence for an operation."
            },
            "valuationKnowledge": {
              "$ref": "#/definitions/AttemptExecutionEvidence/properties/usageCost/properties/cashKnowledge"
            }
          },
          "required": [
            "cashUsd",
            "valuationUsd",
            "unknownUsd",
            "cashKnowledge",
            "valuationKnowledge"
          ],
          "additionalProperties": false,
          "description": "Observed usage components. An amount of unknown meaning is not charged cash; separately proven included service can still establish exact zero incremental cash unless its route reports no actual debit."
        }
      },
      "required": [
        "attemptId",
        "harnessId"
      ],
      "additionalProperties": false,
      "description": "Compact projection of existing attempt execution and amount evidence."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
