{
  "$ref": "#/definitions/ControlModelOperationDetail",
  "definitions": {
    "ControlModelOperationDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty identifier string."
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ],
          "description": "Run lifecycle: queued, running, then exactly one of succeeded / failed / cancelled / interrupted. Outcome quality (checks, review, delivery) is orthogonal."
        },
        "admission": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "enum": [
                    "model",
                    "non_model"
                  ]
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "queued",
                    "active"
                  ]
                },
                "blockers": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "global_limit"
                          },
                          "limit": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991,
                            "exclusiveMinimum": 0
                          }
                        },
                        "required": [
                          "kind",
                          "limit"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "class_limit"
                          },
                          "limit": {
                            "$ref": "#/definitions/ControlModelOperationDetail/properties/admission/anyOf/0/properties/blockers/items/anyOf/0/properties/limit"
                          }
                        },
                        "required": [
                          "kind",
                          "limit"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "thread_busy"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "stopping"
                          }
                        },
                        "required": [
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              },
              "required": [
                "class",
                "phase",
                "blockers"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Current scheduler observation for this operation; absent on engines without admission disclosure."
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 timestamp string."
        },
        "startedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO-8601 timestamp string."
        },
        "finishedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO-8601 timestamp string."
        },
        "dispatch": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_started",
                "started",
                "response_received",
                "unknown"
              ]
            },
            "startedAt": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 timestamp string."
            },
            "route": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "$ref": "#/definitions/ControlModelOperationDetail/properties/id"
                    },
                    "credentialProfileId": {
                      "$ref": "#/definitions/ControlModelOperationDetail/properties/id"
                    },
                    "accountFingerprint": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "model": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "credentialProfileId",
                    "accountFingerprint",
                    "model"
                  ],
                  "additionalProperties": false,
                  "description": "Selected route at dispatch; a result records the actually observed model, or null."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Selected route at dispatch; a result records the actually observed model, or null."
            }
          },
          "required": [
            "state",
            "startedAt",
            "route"
          ],
          "additionalProperties": false,
          "description": "Started means the physical send may have begun, not proof the upstream accepted it. A terminal not_started may refine that attempted send only with typed proof no complete inference request was delivered; startedAt and route retain the attempt."
        },
        "response": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "absent"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "ready"
                },
                "ref": {
                  "type": "object",
                  "properties": {
                    "resourceId": {
                      "$ref": "#/definitions/ControlModelOperationDetail/properties/id"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "sizeBytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "resourceId",
                    "sha256",
                    "sizeBytes"
                  ],
                  "additionalProperties": false,
                  "description": "Digest-bound model-purpose resource; never an Agent attachment."
                },
                "readyAt": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
                },
                "expiresAt": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
                }
              },
              "required": [
                "state",
                "ref",
                "readyAt",
                "expiresAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "acknowledged"
                },
                "ref": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/response/anyOf/1/properties/ref"
                },
                "releasedAt": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
                }
              },
              "required": [
                "state",
                "ref",
                "releasedAt"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "expired"
                },
                "ref": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/response/anyOf/1/properties/ref"
                },
                "releasedAt": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/createdAt"
                }
              },
              "required": [
                "state",
                "ref",
                "releasedAt"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Result GET does not acknowledge delivery. Acknowledged/expired bytes never cause another generation."
        },
        "usage": {
          "type": "object",
          "properties": {
            "input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "output_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cached_input_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "cache_write_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "reasoning_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "additionalProperties": false,
          "description": "Provider-reported counters for one generation; missing counters remain null."
        },
        "cost": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "processing": {
                  "type": "object",
                  "properties": {
                    "nativeMode": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S",
                          "description": "User-supplied string that must contain visible content, not just whitespace."
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "User-supplied string that must contain visible content, not just whitespace."
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "included",
                        "paid_credits",
                        "cash",
                        "valuation",
                        "unknown"
                      ]
                    },
                    "source": {
                      "$ref": "#/definitions/ControlModelOperationDetail/properties/cost/anyOf/0/properties/processing/properties/nativeMode/anyOf/0"
                    }
                  },
                  "required": [
                    "nativeMode",
                    "kind",
                    "source"
                  ],
                  "additionalProperties": false,
                  "description": "Mode-qualified billing evidence for an existing cost record. Authentication alone does not establish included premium service; credits, cash, and token valuation stay distinct."
                },
                "knowledge": {
                  "type": "string",
                  "enum": [
                    "exact",
                    "estimated",
                    "unknown"
                  ],
                  "description": "Quality of incremental-cash cost evidence for an operation."
                },
                "billing": {
                  "type": "string",
                  "enum": [
                    "proven_zero",
                    "subscription_entitlement",
                    "metered",
                    "unknown"
                  ],
                  "description": "What is actually known about incremental billing; a native credential route alone never proves entitlement or zero cost."
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "provenance": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "estimatedUsd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "cashUsd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "valuationUsd": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "valuationKnowledge": {
                  "$ref": "#/definitions/ControlModelOperationDetail/properties/cost/anyOf/0/properties/knowledge",
                  "default": "unknown",
                  "description": "Quality of incremental-cash cost evidence for an operation."
                }
              },
              "required": [
                "knowledge",
                "billing",
                "source",
                "provenance"
              ],
              "additionalProperties": false,
              "description": "Incremental cash and token valuation are independent; subscription credentials alone never invent a cash receipt."
            },
            {
              "type": "null"
            }
          ],
          "description": "Incremental cash and token valuation are independent; subscription credentials alone never invent a cash receipt."
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "fieldErrors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "default": {}
                },
                "requiredActions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "context": {
                  "type": "object",
                  "additionalProperties": {},
                  "default": {},
                  "description": "Typed route-specific recovery context; never a duplicate error message."
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "state",
        "createdAt",
        "startedAt",
        "finishedAt",
        "dispatch",
        "response",
        "usage",
        "cost",
        "problem"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
