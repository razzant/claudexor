{
  "$ref": "#/definitions/McpUploadCreateInput",
  "definitions": {
    "McpUploadCreateInput": {
      "type": "object",
      "properties": {
        "request": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "image",
                "file"
              ],
              "description": "Kind of attached resource: image input or generic file bytes."
            },
            "mime": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "default": ""
            },
            "sizeBytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "mime",
            "sizeBytes"
          ],
          "additionalProperties": false
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 256,
          "description": "Caller-owned key for this exact stage. Save key and body before calling; replay both after an unknown response."
        }
      },
      "required": [
        "request",
        "idempotencyKey"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
