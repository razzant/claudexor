{
  "$ref": "#/definitions/ControlRunRetryResponse",
  "definitions": {
    "ControlRunRetryResponse": {
      "type": "object",
      "properties": {
        "taskGroupId": {
          "type": "string",
          "format": "uuid",
          "description": "Caller-generated UUID saved before launching the first member. Each job still needs its own idempotency key; the group grants no execution authority."
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "description": "Identity of the durable engine store that accepted this command, stable across restarts. A group member always carries it; an ordinary receipt carries it only for a request sending `X-Claudexor-Store-Identity: 1`, and it stays absent, meaning unknown, when the store has no identity to give."
        },
        "retryOf": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty identifier string."
        },
        "jobId": {
          "$ref": "#/definitions/ControlRunRetryResponse/properties/retryOf"
        },
        "runId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlRunRetryResponse/properties/retryOf"
            },
            {
              "type": "null"
            }
          ],
          "description": "Non-empty identifier string.",
          "default": null
        },
        "turnId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlRunRetryResponse/properties/retryOf"
            },
            {
              "type": "null"
            }
          ],
          "description": "Non-empty identifier string.",
          "default": null
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "retryOf",
        "jobId",
        "state"
      ],
      "additionalProperties": false,
      "description": "Durable handle returned by Exact Retry for a fresh command attempt."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
