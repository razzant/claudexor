{
  "$ref": "#/definitions/ControlPreparationReleaseRequest",
  "definitions": {
    "ControlPreparationReleaseRequest": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirm_processes_ended": {
          "type": "boolean",
          "const": true,
          "description": "The operator checked that the stopped preparation's processes and their children have ended."
        }
      },
      "required": [
        "selector",
        "digest",
        "confirm_processes_ended"
      ],
      "additionalProperties": false,
      "description": "Release one held preparation resource on the operator's confirmation."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
