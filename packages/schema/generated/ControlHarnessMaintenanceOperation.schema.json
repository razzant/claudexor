{
  "$ref": "#/definitions/ControlHarnessMaintenanceOperation",
  "definitions": {
    "ControlHarnessMaintenanceOperation": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "accepted",
            "preparing",
            "installing",
            "settled"
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "latest"
                },
                "version": {
                  "type": "null"
                }
              },
              "required": [
                "kind",
                "version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version"
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
                  "description": "One exact vendor version, never a range or a release fixture stamp."
                }
              },
              "required": [
                "kind",
                "version"
              ],
              "additionalProperties": false
            }
          ]
        },
        "requester": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string"
            },
            "requestId": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "source",
            "requestId"
          ],
          "additionalProperties": false
        },
        "installationHome": {
          "type": [
            "string",
            "null"
          ]
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "binary": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "script": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string"
                      },
                      "size": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                      },
                      "sha256": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "url",
                      "size",
                      "sha256"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "binary",
              "args",
              "env",
              "script"
            ],
            "additionalProperties": false
          }
        },
        "before": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "realPath": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "versionOutput": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "overrideEnv": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "overrideValue": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "path",
                "realPath",
                "version",
                "versionOutput",
                "overrideEnv",
                "overrideValue"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlHarnessMaintenanceOperation/properties/before/anyOf/0"
            },
            {
              "type": "null"
            }
          ]
        },
        "elsewhere": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "before": {
                  "$ref": "#/definitions/ControlHarnessMaintenanceOperation/properties/before/anyOf/0"
                },
                "after": {
                  "$ref": "#/definitions/ControlHarnessMaintenanceOperation/properties/before/anyOf/0"
                }
              },
              "required": [
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "activeRunsAtStart": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "A fact, never permission to proceed; null when the CLI has no daemon run census."
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "changed",
            "not_changed",
            "changed_elsewhere",
            "unknown"
          ]
        },
        "mutation": {
          "type": "string",
          "enum": [
            "none",
            "applied",
            "unknown"
          ]
        },
        "termination": {
          "type": "string",
          "enum": [
            "not_applicable",
            "confirmed",
            "unconfirmed"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "progress": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "description": "Bounded, redacted vendor diagnostics, including advice when nothing changed."
        },
        "problem": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                },
                "fieldErrors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "default": {}
                },
                "requiredActions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "evidenceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "default": []
                },
                "context": {
                  "type": "object",
                  "additionalProperties": {},
                  "default": {},
                  "description": "Typed route-specific recovery context; never a duplicate error message."
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 timestamp string."
        },
        "startedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlHarnessMaintenanceOperation/properties/createdAt"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO-8601 timestamp string."
        },
        "finishedAt": {
          "anyOf": [
            {
              "$ref": "#/definitions/ControlHarnessMaintenanceOperation/properties/createdAt"
            },
            {
              "type": "null"
            }
          ],
          "description": "ISO-8601 timestamp string."
        }
      },
      "required": [
        "phase",
        "target",
        "requester",
        "installationHome",
        "commands",
        "before",
        "after",
        "elsewhere",
        "activeRunsAtStart",
        "exitCode",
        "outcome",
        "mutation",
        "termination",
        "limitations",
        "progress",
        "problem",
        "id",
        "harness",
        "state",
        "createdAt",
        "startedAt",
        "finishedAt"
      ],
      "additionalProperties": false,
      "description": "A durable maintenance operation; acceptance is a handle, not completion."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
