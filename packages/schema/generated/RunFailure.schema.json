{
  "$ref": "#/definitions/RunFailure",
  "definitions": {
    "RunFailure": {
      "type": "object",
      "properties": {
        "requestRefusal": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "scope": {
                  "type": "string",
                  "const": "turn_text",
                  "description": "All text input items in one native turn; separate instructions are excluded."
                },
                "unit": {
                  "type": "string",
                  "const": "unicode_scalars"
                },
                "limit": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "const": "input_too_large"
                },
                "actual": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "native_code": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "scope",
                "unit",
                "limit",
                "source",
                "kind",
                "actual",
                "native_code"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "vendor_cli_too_old"
                },
                "native_code": {
                  "type": "string",
                  "const": "claude_code_version_too_old"
                },
                "source": {
                  "type": "string",
                  "const": "claude_stdout"
                },
                "binary_path": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "installed_version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "native_code",
                "source",
                "binary_path",
                "installed_version"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "credential_source_unconfirmed"
                },
                "native_code": {
                  "type": "string",
                  "const": "grok_credential_source_unconfirmed"
                },
                "source": {
                  "type": "string",
                  "const": "grok_init"
                },
                "reported_source": {
                  "type": "string",
                  "maxLength": 80,
                  "description": "Redacted credential source the vendor's startup frame reported."
                }
              },
              "required": [
                "kind",
                "native_code",
                "source",
                "reported_source"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Vendor-attested request refusal that stops retries and account rotation on its harness; input, executable and credential-source causes carry their own evidence."
        },
        "rawContextShortfall": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1,
              "description": "Model whose window was checked."
            },
            "context_window": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "packet_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "The packet with every optional file omitted: mandatory files, file manifest and metadata."
            },
            "framing_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "The request outside the packet: instructions, user text, patch protocol and attachments."
            },
            "output_allowance_tokens": {
              "type": "integer",
              "minimum": 0,
              "description": "Tokens kept free for the answer."
            },
            "mandatory_files": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "estimated_tokens": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "This file's share of packet_tokens: its packet entry with content and evidence."
                  }
                },
                "required": [
                  "path",
                  "estimated_tokens"
                ],
                "additionalProperties": false
              },
              "description": "Every mandatory file, largest first."
            }
          },
          "required": [
            "model",
            "context_window",
            "packet_tokens",
            "framing_tokens",
            "output_allowance_tokens",
            "mandatory_files"
          ],
          "additionalProperties": false,
          "description": "Typed sizes behind code raw_context_exceeds_window: the window, the request's parts and every mandatory file, so surfaces never read them from safeMessage."
        },
        "captureFailure": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "capture_output_exceeded",
                "capture_output_incomplete",
                "capture_preview_truncated",
                "capture_space_insufficient",
                "capture_git_stalled",
                "capture_git_signal",
                "capture_read_failed",
                "capture_object_missing",
                "capture_failed"
              ]
            },
            "message": {
              "type": "string"
            },
            "causeCode": {
              "type": "string"
            },
            "bufferBudgetBytes": {
              "type": "integer",
              "minimum": 0
            },
            "stream": {
              "type": "string",
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "drain": {
              "type": "string",
              "const": "truncated"
            },
            "requiredBytes": {
              "type": "integer",
              "minimum": 0
            },
            "availableBytes": {
              "type": "integer",
              "minimum": 0
            },
            "signal": {
              "type": "string",
              "maxLength": 32
            },
            "stallMs": {
              "type": "integer",
              "minimum": 0
            },
            "cleanup": {
              "type": "object",
              "properties": {
                "code": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            },
            "inventory": {
              "type": "object",
              "properties": {
                "exact": {
                  "type": "boolean",
                  "const": false,
                  "description": "Always false: an inventory names files; it is not the exact change."
                },
                "changedFiles": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Changed paths the pass counted."
                },
                "largest": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "maxLength": 1024,
                        "description": "Top-relative changed path, exact within the length cap."
                      },
                      "change": {
                        "type": "string",
                        "enum": [
                          "added",
                          "modified",
                          "deleted",
                          "type_changed"
                        ],
                        "description": "What happened to the path between the turn's base and the uncaptured tree."
                      },
                      "sizeBytes": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "Size of the new blob (of the old blob for a deletion); null when Git could not size it."
                      }
                    },
                    "required": [
                      "path",
                      "change",
                      "sizeBytes"
                    ],
                    "additionalProperties": false,
                    "description": "One changed path of a non-exact capture inventory."
                  },
                  "maxItems": 20,
                  "description": "The largest changed files, largest first."
                }
              },
              "required": [
                "exact",
                "changedFiles",
                "largest"
              ],
              "additionalProperties": false,
              "description": "Bounded non-exact inventory of the changed files behind a refused capture."
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "phase": {
          "type": "string",
          "default": "unknown",
          "description": "Pipeline phase where the failure happened."
        },
        "category": {
          "type": "string",
          "enum": [
            "validation",
            "project",
            "auth",
            "harness_unavailable",
            "harness_error",
            "config_error",
            "budget",
            "policy",
            "cancelled",
            "internal",
            "unknown"
          ],
          "default": "unknown",
          "description": "Typed failure category (validation, project, auth, harness, config, budget, policy, cancelled, internal, unknown). config_error is a settings/routing misconfiguration (e.g. quality routing with no comparable tier), corrected by changing configuration, not by re-auth or waiting for a harness."
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "finite_zero",
                "hard_cap",
                "estimate_headroom",
                "unknown_paid_in_flight",
                "budget_overshoot",
                "cost_unverifiable",
                "delegation_child_drain_timeout",
                "subscription_window_exhausted",
                "credential_pool_exhausted",
                "input_too_large",
                "raw_context_mandatory_unavailable",
                "raw_context_exceeds_window",
                "model_catalog_unavailable",
                "vendor_cli_too_old",
                "credential_source_unconfirmed",
                "delegated_home_unavailable",
                "delegated_confinement_unavailable",
                "delegated_evidence_incomplete",
                "access_profile_incompatible",
                "auxiliary_writable_roots_unsupported",
                "retired_access_profile"
              ],
              "description": "Machine-readable failure sub-code within a RunFailure category, including historical delegated-run failures and active access-profile refusals."
            },
            {
              "type": "null"
            }
          ],
          "description": "Machine-readable failure sub-code within the category; null when the category alone is sufficient. Surfaces choose remediation from this, never by parsing safeMessage.",
          "default": null
        },
        "harnessId": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Harness involved in the failure, when known."
        },
        "attemptId": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Attempt involved in the failure, when known."
        },
        "safeMessage": {
          "type": "string",
          "description": "Redacted human-readable failure message."
        },
        "rawDetailRef": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Artifact path holding the raw (redacted) failure detail."
        },
        "logRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Log artifact paths relevant to the failure."
        },
        "eventRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Event references relevant to the failure."
        },
        "runDir": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Run artifact directory."
        },
        "resetsAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the refused window reopens (a spent subscription quota window), or null when the failure has no such time. Callers schedule a retry off this field, never off safeMessage."
        },
        "quotaRefusal": {
          "type": "object",
          "properties": {
            "basis": {
              "type": "string",
              "enum": [
                "owner_reserve",
                "provider_window",
                "provider_cooldown"
              ],
              "description": "owner_reserve: usage reached the saved headroom_threshold below 100% while the provider reports quota left; provider_window: the provider reports the window spent; provider_cooldown: a provider rate-limit cooldown is in force."
            },
            "constraintId": {
              "type": [
                "string",
                "null"
              ],
              "description": "The refusing quota window, when known."
            },
            "usedRatio": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Its observed usage, when known."
            },
            "threshold": {
              "type": [
                "number",
                "null"
              ],
              "description": "The headroom_threshold the decision applied, when it applied one."
            }
          },
          "required": [
            "basis",
            "constraintId",
            "usedRatio",
            "threshold"
          ],
          "additionalProperties": false,
          "description": "Present when quota admission refused the account (code subscription_window_exhausted): separates the owner's saved reserve from provider exhaustion. Absent on other failures and on records written before this field existed."
        },
        "vendorFailure": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "code": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The vendor's own machine-readable failure code, verbatim; null when the vendor recorded an error without one."
                },
                "message": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 4000
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The vendor's own words from the same record, verbatim (redacted); null when absent."
                },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "description": "Evidence channel the code was read from (codex: `codex_rollout`). An open vocabulary: consumers display it, never branch on it."
                }
              },
              "required": [
                "code",
                "message",
                "source"
              ],
              "additionalProperties": false,
              "description": "Vendor-typed failure evidence read from a vendor-owned machine-readable record, never parsed from prose."
            },
            {
              "type": "null"
            }
          ],
          "description": "The vendor's own typed failure for the attempt this record speaks for, or null when no vendor-typed evidence exists (every harness without such a channel, and any unreadable record). Facts only: carries no remedy.",
          "default": null
        },
        "poolAttempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "harnessId": {
                "type": "string",
                "minLength": 1,
                "description": "Harness the try ran on."
              },
              "profileId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Account row the try ran on; null = the harness default route."
              },
              "profileDisplayName": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The row's display name at try time (redacted); null for the default route."
              },
              "requestedModel": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Model the try asked for; null = the harness default model."
              },
              "attemptId": {
                "type": "string",
                "minLength": 1,
                "description": "Attempt the try belongs to."
              },
              "tryIndex": {
                "type": "integer",
                "minimum": 0,
                "description": "Zero-based try index within the attempt."
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "description": "When the try's first error was observed."
              },
              "phase": {
                "type": "string",
                "enum": [
                  "pre_start",
                  "pre_progress",
                  "after_progress"
                ],
                "description": "How far the try got: before a typed session start, after start but before agent progress, or after progress."
              },
              "category": {
                "type": "string",
                "enum": [
                  "timeout",
                  "rate_limited",
                  "auth_failed",
                  "capability_refused",
                  "process_crash",
                  "config_error",
                  "unknown_harness_error"
                ],
                "description": "Typed failure category of the try; untyped errors are unknown_harness_error."
              },
              "error": {
                "type": "string",
                "description": "The try's own error text with its original wording and whitespace, redacted."
              },
              "vendorFailure": {
                "anyOf": [
                  {
                    "$ref": "#/definitions/RunFailure/properties/vendorFailure/anyOf/0"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The vendor's own typed failure for this try, when the adapter attached one."
              }
            },
            "required": [
              "harnessId",
              "profileId",
              "profileDisplayName",
              "requestedModel",
              "attemptId",
              "tryIndex",
              "observedAt",
              "phase",
              "category",
              "error",
              "vendorFailure"
            ],
            "additionalProperties": false,
            "description": "Per-try account attribution of a failed execution try (diagnostic evidence only)."
          },
          "default": [],
          "description": "Every failed execution try in order, each with its own account and error text; empty when no try failed (and for records written before this field existed)."
        },
        "nextActions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Suggested operator next actions."
        }
      },
      "required": [
        "safeMessage"
      ],
      "additionalProperties": false,
      "description": "Typed failure record for a run: phase, category, evidence references, and suggested next actions."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
