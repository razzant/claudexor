{
  "$ref": "#/definitions/McpRunEventReadInput",
  "definitions": {
    "McpRunEventReadInput": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "seq": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "The event to read, e.g. claudexor_run_wait's oversizedEvent.seq."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "default": 0,
          "description": "0, or the previous part's nextOffset."
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 4,
          "maximum": 65536,
          "default": 32768,
          "description": "Upper bound of this part's UTF-8 bytes; a part may end earlier at a character boundary."
        }
      },
      "required": [
        "runId",
        "seq"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
