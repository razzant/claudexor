{
  "$ref": "#/definitions/ImageCallRequest",
  "definitions": {
    "ImageCallRequest": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Non-empty identifier string."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Explicit image model; never derived from a text model."
        },
        "account": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "auto"
                },
                "preferredProfileId": {
                  "$ref": "#/definitions/ImageCallRequest/properties/source",
                  "description": "Non-empty identifier string."
                }
              },
              "required": [
                "mode"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "const": "pin"
                },
                "profileId": {
                  "$ref": "#/definitions/ImageCallRequest/properties/source"
                }
              },
              "required": [
                "mode",
                "profileId"
              ],
              "additionalProperties": false
            }
          ],
          "description": "Auto text operations prefer preferredProfileId among unmarked accounts of the same catalog tier (listed before unlisted); a listed alternative, a mark or a recent refusal outranks it. History bound to that account keeps it first over a catalog miss only while it has neither a mark nor a recent refusal. Image operations order accounts by the pool alone. Pin never selects another account."
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "User-supplied string that must contain visible content, not just whitespace."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mime": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/webp"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$",
                "description": "Digest of the decoded bytes."
              },
              "dataBase64": {
                "type": "string",
                "minLength": 1,
                "description": "The caller's exact bytes in standard base64; forwarded verbatim, never re-encoded."
              }
            },
            "required": [
              "mime",
              "sha256",
              "dataBase64"
            ],
            "additionalProperties": false,
            "description": "One caller-owned edit reference; decoded bytes must match mime and sha256."
          },
          "default": [],
          "description": "Empty selects generation; one or more selects an edit of these references."
        },
        "options": {
          "type": "object",
          "properties": {
            "size": {
              "$ref": "#/definitions/ImageCallRequest/properties/prompt",
              "description": "Vendor size token, e.g. \"auto\" or \"1024x1024\"."
            },
            "quality": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "auto"
              ]
            },
            "background": {
              "type": "string",
              "enum": [
                "transparent",
                "opaque",
                "auto"
              ]
            },
            "n": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10,
              "description": "Requested image count in ONE provider request. Omitted sends no n; the provider may return several items either way."
            }
          },
          "additionalProperties": false,
          "description": "Only explicit options are sent; this transport adds no defaults of its own.",
          "default": {}
        }
      },
      "required": [
        "source",
        "model",
        "account",
        "prompt"
      ],
      "additionalProperties": false,
      "description": "One image generation or edit request, stored only in a model-purpose payload outside the command journal."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
