{
  "$ref": "#/definitions/ControlDaemonStatus",
  "definitions": {
    "ControlDaemonStatus": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "uptime_ms": {
          "type": "number",
          "minimum": 0
        },
        "queue": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "boolean"
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "jobs": {
          "type": "integer",
          "minimum": 0
        },
        "stopping": {
          "type": "boolean"
        },
        "servingMode": {
          "type": "string",
          "enum": [
            "normal",
            "recovery_only"
          ]
        },
        "capacity": {
          "type": "object",
          "properties": {
            "maxConcurrent": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "const": "unlimited"
                }
              ]
            },
            "maxConcurrentNonModelJobs": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/maxConcurrent"
            },
            "maxConcurrentModelOperations": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/maxConcurrent"
            },
            "maxParallelCandidates": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/maxConcurrent/anyOf/0"
            },
            "maxDeepScanWidth": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/maxConcurrent/anyOf/0"
            },
            "maxCouncilMembers": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "sources": {
              "type": "object",
              "properties": {
                "max_concurrent": {
                  "type": "string",
                  "enum": [
                    "default",
                    "config",
                    "environment",
                    "embedder",
                    "unknown"
                  ]
                },
                "max_concurrent_non_model_jobs": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/sources/properties/max_concurrent"
                },
                "max_concurrent_model_operations": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/sources/properties/max_concurrent"
                },
                "max_parallel_candidates": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/sources/properties/max_concurrent"
                },
                "max_deep_scan_width": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/sources/properties/max_concurrent"
                },
                "max_council_members": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/sources/properties/max_concurrent"
                }
              },
              "required": [
                "max_concurrent",
                "max_concurrent_non_model_jobs",
                "max_concurrent_model_operations",
                "max_parallel_candidates",
                "max_deep_scan_width",
                "max_council_members"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "maxConcurrent"
          ],
          "additionalProperties": false
        },
        "admission": {
          "type": "object",
          "properties": {
            "active": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_model": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "model",
                "non_model"
              ],
              "additionalProperties": false
            },
            "queued": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "integer",
                  "minimum": 0
                },
                "non_model": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "model",
                "non_model"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "active",
            "queued"
          ],
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "properties": {
            "heapUsedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "heapLimitBytes": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
            },
            "rssBytes": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
            },
            "externalBytes": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
            },
            "nodeHeapArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "atAdmission": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "heapUsedBytes": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
                    },
                    "rssBytes": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
                    },
                    "at": {
                      "type": "string",
                      "minLength": 1,
                      "description": "ISO-8601 timestamp string."
                    }
                  },
                  "required": [
                    "heapUsedBytes",
                    "rssBytes",
                    "at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "sampledAt": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
            }
          },
          "required": [
            "heapUsedBytes",
            "heapLimitBytes",
            "rssBytes",
            "externalBytes",
            "nodeHeapArgs",
            "atAdmission",
            "sampledAt"
          ],
          "additionalProperties": false
        },
        "store": {
          "type": "object",
          "properties": {
            "flusher": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "starting",
                        "up",
                        "down"
                      ]
                    },
                    "interval_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "acknowledged_generation": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    },
                    "pending_registrations": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    },
                    "pending_waiters": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    },
                    "flush_lag_ms": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                    },
                    "last_barrier_at": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "ISO-8601 timestamp string."
                    },
                    "last_pass": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "at": {
                              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                            },
                            "pass_ms": {
                              "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                            },
                            "barrier_ms": {
                              "anyOf": [
                                {
                                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "dirty": {
                              "type": "boolean"
                            },
                            "barrier": {
                              "type": "boolean"
                            },
                            "wal_bytes": {
                              "anyOf": [
                                {
                                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "checkpoint": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "busy": {
                                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                                    },
                                    "log": {
                                      "type": "integer"
                                    },
                                    "checkpointed": {
                                      "type": "integer"
                                    }
                                  },
                                  "required": [
                                    "busy",
                                    "log",
                                    "checkpointed"
                                  ],
                                  "additionalProperties": false
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "at",
                            "pass_ms",
                            "barrier_ms",
                            "dirty",
                            "barrier",
                            "wal_bytes",
                            "checkpoint"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "counters": {
                      "type": "object",
                      "properties": {
                        "passes": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        },
                        "barriers": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        },
                        "dirSyncs": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        },
                        "busyPassive": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        },
                        "walReopens": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        },
                        "restarts": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        },
                        "deaths": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                        }
                      },
                      "required": [
                        "passes",
                        "barriers",
                        "dirSyncs",
                        "busyPassive",
                        "walReopens",
                        "restarts",
                        "deaths"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "state",
                    "interval_ms",
                    "generation",
                    "acknowledged_generation",
                    "pending_registrations",
                    "pending_waiters",
                    "flush_lag_ms",
                    "last_barrier_at",
                    "last_pass",
                    "counters"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "flush_lag_ms": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_barrier_at": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 timestamp string."
            },
            "interval_ms": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                },
                {
                  "type": "null"
                }
              ]
            },
            "wal_bytes": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "busy_waits": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "commit": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "attempts": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "COMMIT calls entered, failed ones included."
                    },
                    "failures": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "COMMIT calls that threw."
                    },
                    "last_ms": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Duration of the latest COMMIT call; null before the first."
                    },
                    "max_ms": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Longest COMMIT call; null before the first."
                    },
                    "p50_ms": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Lifetime COMMIT p50, microsecond histogram with two significant digits; absent on older engines."
                    },
                    "p99_ms": {
                      "anyOf": [
                        {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/interval_ms"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "Lifetime COMMIT p99, microsecond histogram with two significant digits; absent on older engines."
                    }
                  },
                  "required": [
                    "attempts",
                    "failures",
                    "last_ms",
                    "max_ms"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "Request-thread transaction COMMIT calls since this engine store opened, timed around the native call only: a WAL header sync or automatic checkpoint SQLite runs inside it is included; BEGIN, the transaction body and ROLLBACK are not. A long call is a measurement, not proof of a disk cause. Null while the store is not open; older engines omit it."
            },
            "obligations_open": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "integrity": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "pending",
                    "ok",
                    "failed"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "migration": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "phase": {
                      "type": "string",
                      "enum": [
                        "reading",
                        "importing",
                        "verifying",
                        "complete",
                        "publishing",
                        "failed"
                      ]
                    },
                    "completedPartitions": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    },
                    "totalPartitions": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    },
                    "currentPartition": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "processedBytes": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    },
                    "totalBytes": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/store/properties/flusher/anyOf/0/properties/generation"
                    }
                  },
                  "required": [
                    "phase",
                    "completedPartitions",
                    "totalPartitions",
                    "currentPartition",
                    "processedBytes",
                    "totalBytes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "flusher",
            "flush_lag_ms",
            "last_barrier_at",
            "interval_ms",
            "wal_bytes",
            "busy_waits",
            "obligations_open",
            "integrity",
            "migration"
          ],
          "additionalProperties": false
        },
        "timing": {
          "type": "object",
          "properties": {
            "windowMs": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "windowEndedAt": {
              "anyOf": [
                {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                },
                {
                  "type": "null"
                }
              ],
              "description": "ISO-8601 timestamp string."
            },
            "routes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "route": {
                    "type": "string"
                  },
                  "outcomes": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "outcome": {
                          "type": "string",
                          "enum": [
                            "served",
                            "not_found",
                            "disconnected_at_entry",
                            "disconnected",
                            "failed"
                          ]
                        },
                        "lifetime": {
                          "type": "object",
                          "properties": {
                            "count": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "p50Ms": {
                              "anyOf": [
                                {
                                  "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "p99Ms": {
                              "anyOf": [
                                {
                                  "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "maxMs": {
                              "anyOf": [
                                {
                                  "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "count",
                            "p50Ms",
                            "p99Ms",
                            "maxMs"
                          ],
                          "additionalProperties": false
                        },
                        "window": {
                          "anyOf": [
                            {
                              "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/routes/items/properties/outcomes/items/properties/lifetime"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "outcome",
                        "lifetime",
                        "window"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 5
                  },
                  "lifetime": {
                    "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/routes/items/properties/outcomes/items/properties/lifetime"
                  },
                  "window": {
                    "anyOf": [
                      {
                        "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/routes/items/properties/outcomes/items/properties/lifetime"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "method",
                  "route",
                  "lifetime",
                  "window"
                ],
                "additionalProperties": false
              },
              "maxItems": 256,
              "description": "Completed responses or disconnects by method and catalog template (never raw URLs). SSE latency includes the stream lifetime. At most 256 keys including OTHER <unmatched>. Fixed histograms use microseconds and two significant digits; max is exact to a microsecond. Window is the last completed loop-facts window, null before the first; empty windows have count zero and null latencies."
            },
            "worstSync": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "operation": {
                    "type": "string",
                    "enum": [
                      "store.begin_immediate",
                      "store.commit",
                      "store.external_write",
                      "control.run_detail",
                      "control.run_summary",
                      "scope.persist"
                    ]
                  },
                  "durationMs": {
                    "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                  },
                  "at": {
                    "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                  }
                },
                "required": [
                  "operation",
                  "durationMs",
                  "at"
                ],
                "additionalProperties": false
              },
              "maxItems": 32,
              "description": "The 32 longest instrumented synchronous sections since process start, descending by duration, retaining later samples on ties. Labels contain no SQL, paths, IDs or payloads. Scope persistence measures synchronous serialization only; its file writes are asynchronous. Sections can overlap; these facts do not attribute a stall to disk or another cause."
            },
            "bulk": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "cursor",
                      "detail",
                      "summary",
                      "event-replay",
                      "artifact"
                    ]
                  },
                  "queue": {
                    "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/routes/items/properties/outcomes/items/properties/lifetime"
                  },
                  "projection": {
                    "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/routes/items/properties/outcomes/items/properties/lifetime"
                  }
                },
                "required": [
                  "kind",
                  "queue",
                  "projection"
                ],
                "additionalProperties": false
              },
              "description": "Finite bulk reads: lifetime queue residence and worker execution wall times, including scheduling and asynchronous retained-output publication. These are not main-thread synchronous sections."
            }
          },
          "required": [
            "windowMs",
            "windowEndedAt",
            "routes",
            "worstSync"
          ],
          "additionalProperties": false,
          "description": "Bounded process timing facts; absent on older engines."
        },
        "loop": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "windowMs": {
                  "type": "number",
                  "minimum": 0,
                  "description": "How long the window lasted. Windows roll every ten seconds; a stalled loop rolls late, so a longer window is itself evidence of a stall."
                },
                "windowEndedAt": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                },
                "delay": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "resolutionMs": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Sampling interval. Each sample is the time between two sampling ticks, so an idle loop's p50 sits near this value, not near zero."
                        },
                        "samples": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "p50Ms": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                        },
                        "p99Ms": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                        },
                        "maxMs": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/timing/properties/windowMs/anyOf/0"
                        }
                      },
                      "required": [
                        "resolutionMs",
                        "samples",
                        "p50Ms",
                        "p99Ms",
                        "maxMs"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Event-loop delay percentiles over the window (perf_hooks.monitorEventLoopDelay, reset each window); null when the window recorded no sample."
                },
                "utilization": {
