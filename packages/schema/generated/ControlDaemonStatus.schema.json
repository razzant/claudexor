{
  "$ref": "#/definitions/ControlDaemonStatus",
  "definitions": {
    "ControlDaemonStatus": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean",
          "const": true
        },
        "uptime_ms": {
          "type": "number",
          "minimum": 0
        },
        "queue": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "boolean"
        },
        "active": {
          "type": "integer",
          "minimum": 0
        },
        "jobs": {
          "type": "integer",
          "minimum": 0
        },
        "stopping": {
          "type": "boolean"
        },
        "servingMode": {
          "type": "string",
          "enum": [
            "normal",
            "recovery_only"
          ]
        },
        "capacity": {
          "type": "object",
          "properties": {
            "maxConcurrent": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "maxParallelCandidates": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/maxConcurrent"
            },
            "maxDeepScanWidth": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/capacity/properties/maxConcurrent"
            },
            "maxCouncilMembers": {
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "maxConcurrent"
          ],
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "properties": {
            "heapUsedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "heapLimitBytes": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
            },
            "rssBytes": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
            },
            "externalBytes": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
            },
            "nodeHeapArgs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "atAdmission": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "heapUsedBytes": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
                    },
                    "rssBytes": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/heapUsedBytes"
                    },
                    "at": {
                      "type": "string",
                      "minLength": 1,
                      "description": "ISO-8601 timestamp string."
                    }
                  },
                  "required": [
                    "heapUsedBytes",
                    "rssBytes",
                    "at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "sampledAt": {
              "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
            }
          },
          "required": [
            "heapUsedBytes",
            "heapLimitBytes",
            "rssBytes",
            "externalBytes",
            "nodeHeapArgs",
            "atAdmission",
            "sampledAt"
          ],
          "additionalProperties": false
        },
        "loop": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "windowMs": {
                  "type": "number",
                  "minimum": 0,
                  "description": "How long the window lasted. Windows roll every ten seconds; a stalled loop rolls late, so a longer window is itself evidence of a stall."
                },
                "windowEndedAt": {
                  "$ref": "#/definitions/ControlDaemonStatus/properties/memory/properties/atAdmission/anyOf/0/properties/at"
                },
                "delay": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "resolutionMs": {
                          "type": "number",
                          "minimum": 0,
                          "description": "Sampling interval. Each sample is the time between two sampling ticks, so an idle loop's p50 sits near this value, not near zero."
                        },
                        "samples": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "p50Ms": {
                          "type": "number",
                          "minimum": 0
                        },
                        "p99Ms": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/loop/anyOf/0/properties/delay/anyOf/0/properties/p50Ms"
                        },
                        "maxMs": {
                          "$ref": "#/definitions/ControlDaemonStatus/properties/loop/anyOf/0/properties/delay/anyOf/0/properties/p50Ms"
                        }
                      },
                      "required": [
                        "resolutionMs",
                        "samples",
                        "p50Ms",
                        "p99Ms",
                        "maxMs"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Event-loop delay percentiles over the window (perf_hooks.monitorEventLoopDelay, reset each window); null when the window recorded no sample."
                },
                "utilization": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Share of the window the loop spent busy (performance.eventLoopUtilization delta); null for a window too short to measure."
                },
                "gc": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "totalMs": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/loop/anyOf/0/properties/delay/anyOf/0/properties/p50Ms"
                    },
                    "maxMs": {
                      "$ref": "#/definitions/ControlDaemonStatus/properties/loop/anyOf/0/properties/delay/anyOf/0/properties/p50Ms"
                    }
                  },
                  "required": [
                    "count",
                    "totalMs",
                    "maxMs"
                  ],
                  "additionalProperties": false,
                  "description": "Garbage-collection pauses observed in the window: count, summed and longest."
                }
              },
              "required": [
                "windowMs",
                "windowEndedAt",
                "delay",
                "utilization",
                "gc"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "The last completed event-loop window; null until the first window completes."
        }
      },
      "required": [
        "ok",
        "uptime_ms",
        "queue",
        "running",
        "active",
        "jobs",
        "stopping",
        "servingMode",
        "capacity",
        "memory",
        "loop"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
