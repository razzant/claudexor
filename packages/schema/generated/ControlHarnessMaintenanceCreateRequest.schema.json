{
  "$ref": "#/definitions/ControlHarnessMaintenanceCreateRequest",
  "definitions": {
    "ControlHarnessMaintenanceCreateRequest": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "target": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "latest"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "version"
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
                  "description": "One exact vendor version, never a range or a release fixture stamp."
                }
              },
              "required": [
                "kind",
                "version"
              ],
              "additionalProperties": false
            }
          ],
          "description": "latest runs the selected program's updater, or installs when missing; version uses the adapter's exact-version command. Retired previous/baseline targets must be sent as version with an explicit version."
        }
      },
      "required": [
        "harness",
        "target"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
