{
  "$ref": "#/definitions/ControlGcReceipt",
  "definitions": {
    "ControlGcReceipt": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1,
          "default": 1
        },
        "dry_run": {
          "type": "boolean",
          "description": "Whether disk was left untouched."
        },
        "started_at": {
          "type": "string",
          "description": "Pass start (ISO 8601)."
        },
        "finished_at": {
          "type": "string",
          "description": "Pass end (ISO 8601)."
        },
        "policy": {
          "type": "object",
          "properties": {
            "runs_max_age_days": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "reviews_max_age_days": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "keep_last_runs_per_project": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "runs_max_age_days",
            "reviews_max_age_days",
            "keep_last_runs_per_project"
          ],
          "additionalProperties": false,
          "description": "The effective retention policy this pass applied."
        },
        "examined_runs": {
          "type": "integer",
          "minimum": 0,
          "description": "Run trees examined."
        },
        "deleted_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "run_id": {
                "type": "string",
                "description": "Deleted (or would-be-deleted) run id."
              },
              "project_root": {
                "type": "string",
                "description": "Canonical project root, or the owned runtime namespace when no project record remains."
              },
              "freed_bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "Bytes the tree occupied."
              }
            },
            "required": [
              "run_id",
              "project_root",
              "freed_bytes"
            ],
            "additionalProperties": false
          },
          "default": [],
          "description": "Run trees deleted (or would-be under dry_run), tombstones left behind."
        },
        "kept": {
          "type": "object",
          "properties": {
            "active": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "recent": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "young": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "referenced": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "actionable": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "unknown_state": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          "additionalProperties": false,
          "description": "Why every surviving candidate survived."
        },
        "held": {
          "type": "object",
          "properties": {
            "roots": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "native_homes": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Vetoed native homes only; unsupported adapters and unknown native entries are informational."
            }
          },
          "additionalProperties": false,
          "description": "Held project roots and vetoed native homes, separate from run counts.",
          "default": {}
        },
        "holds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "missing_partition",
                  "unbound_active_registration",
                  "recovery_pending",
                  "namespace_unreadable",
                  "anchor_references_unreadable",
                  "references_changed",
                  "native_home_veto",
                  "cleanup_suppressed"
                ]
              },
              "count": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "example": {
                "type": "string",
                "description": "Named cause and affected owner, such as a changed registration, unreadable row or pending recovery partition."
              }
            },
            "required": [
              "class",
              "count",
              "example"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "truncated": {
          "type": "boolean",
          "default": false
        },
        "deleted_reviews": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Deleted standalone diff-review tree."
              },
              "freed_bytes": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "path",
              "freed_bytes"
            ],
            "additionalProperties": false
          },
          "default": [],
          "description": "Standalone diff-review trees deleted (or would-be under dry_run)."
        },
        "freed_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Total bytes freed (or reclaimable under dry_run)."
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Non-fatal per-tree failures; the pass continues past them."
        },
        "data_root_unrecognized": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Names of top-level entries in the Claudexor-owned data root that the engine does not own and will never touch (advisory only — nothing here is ever deleted). The full sorted list. Present ONLY when the request opted in via data_root_report; ABSENT (not empty) when the request did not opt in, the scan failed, or the serving daemon predates the feature; a scan failure is disclosed in errors instead."
        },
        "native_homes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "harness_id": {
                "type": "string"
              },
              "profile_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "home": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "checked",
                  "not_pruned"
                ]
              },
              "reason": {
                "type": "string"
              },
              "deleted_files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "freed_bytes": {
                "type": "integer",
                "minimum": 0
              },
              "kept_referenced": {
                "type": "integer",
                "minimum": 0
              },
              "kept_recent": {
                "type": "integer",
                "minimum": 0
              },
              "kept_unknown": {
                "type": "integer",
                "minimum": 0,
                "description": "Unknown native entries preserved without a hold; informational only."
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "harness_id",
              "profile_id",
              "home",
              "status",
              "reason",
              "deleted_files",
              "errors",
              "freed_bytes",
              "kept_referenced",
              "kept_recent",
              "kept_unknown",
              "truncated"
            ],
            "additionalProperties": false
          },
          "description": "Per-home adapter retirement decisions; present only when native_home_report was requested. Unknown vendor data and unreadable references are kept with a reason."
        },
        "model_payloads": {
          "type": "object",
          "properties": {
            "released": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "released",
            "errors"
          ],
          "additionalProperties": false,
          "description": "Model resource identifiers released (or would be under dry_run), plus cleanup failures; present only when model_payload_report was requested."
        },
        "purged_threads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of trashed threads whose purge_after had passed and that this pass purged (or would purge under dry_run). Present only when trash_purge_report was requested; a skipped (busy) or failed purge is disclosed in errors instead."
        },
        "purge_leftovers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids of already purged threads whose directory cleanup had failed after the purge was journaled (an isolated worktree or lane home still on disk) and that this pass finished (or would finish under dry_run). Present only when trash_purge_report was requested; a cleanup that fails again is disclosed in errors and retried by the next pass."
        }
      },
      "required": [
        "dry_run",
        "started_at",
        "finished_at",
        "policy",
        "examined_runs",
        "kept",
        "freed_bytes"
      ],
      "additionalProperties": false,
      "description": "Typed receipt of one retention pass."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
